{
  "name": "image-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Local photo pipeline: looks, crops, WYSIWYG preview, batch export, card import.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --import tsx --watch --watch-preserve-output server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "npm run build && node --import tsx server/src/index.ts",
    "serve": "node --import tsx server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "execa": "^10.0.1",
    "exiftool-vendored": "^37.2.0",
    "fastify": "^5.12.0",
    "hash-wasm": "^4.12.0",
    "heic-decode": "^2.1.0",
    "libraw-wasm": "^1.6.0",
    "lucide-react": "^1.31.0",
    "p-limit": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "trash": "^10.1.1",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
